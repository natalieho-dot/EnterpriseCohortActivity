<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Crumb &amp; Co. system builder</title>
<style>
@font-face{font-family:"Roobert Headlines";src:url(data:font/woff2;base64,) format("woff2");font-weight:300 900;font-display:swap}
@font-face{font-family:"Roobert Body";src:url(data:font/woff2;base64,) format("woff2");font-weight:300 900;font-display:swap}
@font-face{font-family:"Roobert SemiMono";src:url(data:font/woff2;base64,) format("woff2");font-weight:300 900;font-display:swap}
:root{
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  --oat-100:#fefdfb; --oat-200:#f4f3f0; --oat-300:#d1cdc7; --oat-400:#7b7974; --oat-500:#1b1a18;
  --tangerine-200:#fcc9ab; --tangerine-300:#ff7714; --tangerine-500:#381005;
  --lemon-200:#fbe189; --lemon-300:#fdbe11; --lemon-500:#372201;
  --lime-100:#fcfee2; --lime-200:#eef773; --lime-300:#cbd810; --lime-400:#808000; --lime-500:#102b03;
  --dragon-200:#f8b9e4; --dragon-300:#ff70d2; --dragon-500:#46022f;
  --pom-100:#fff1f2; --pom-200:#fcbabe; --pom-300:#fb4450; --pom-500:#3a0308;
  --slushie-100:#f0fcff; --slushie-300:#3bd3fd; --slushie-400:#008bad;
  --font-display:"Roobert Headlines","Roobert","Inter Tight","Inter",system-ui,sans-serif;
  --font-body:"Roobert Body","Roobert","Inter Tight","Inter",system-ui,sans-serif;
  --font-mono:"Roobert SemiMono","JetBrains Mono",ui-monospace,monospace;
  --bg:var(--oat-100); --raised:var(--oat-200); --fg:var(--oat-500); --muted:var(--oat-400);
  --border:#edebe8; --dash:var(--oat-300);
  --bad-bg:var(--pom-100); --on-bad:var(--pom-500); --ok-bg:var(--lime-100); --ok-ink:var(--lime-500);
  --new-head:var(--lime-200); --new-cell:var(--lime-100); --chip-bg:var(--oat-100);
  --sel-bg:var(--slushie-100); --sel-ic:var(--slushie-400); --skel:#e6e3dd;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:var(--oat-500); --raised:#2a2825; --fg:var(--oat-100); --muted:#a8a49c; --border:#3a3733; --dash:#5a564f;
    --bad-bg:#3a1a1d; --on-bad:var(--pom-200); --ok-bg:#232a10; --ok-ink:var(--lime-200);
    --new-head:#4a5013; --new-cell:#2a2f12; --sel-bg:#12333b; --sel-ic:var(--slushie-300); --skel:#3a3733;
  }
}
:root[data-theme="dark"]{
  --bg:var(--oat-500); --raised:#2a2825; --fg:var(--oat-100); --muted:#a8a49c; --border:#3a3733; --dash:#5a564f;
  --bad-bg:#3a1a1d; --on-bad:var(--pom-200); --ok-bg:#232a10; --ok-ink:var(--lime-200);
  --new-head:#4a5013; --new-cell:#2a2f12; --sel-bg:#12333b; --sel-ic:var(--slushie-300); --skel:#3a3733;
}
*{box-sizing:inherit}
html,body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--font-body);letter-spacing:.015em;-webkit-text-size-adjust:100%}
body{padding:24px;max-width:1280px;margin:0 auto}
.eyebrow,.lab,th,.chip,.tag,.meta{font-family:var(--font-mono);text-transform:uppercase;letter-spacing:.08em;font-weight:600}
.eyebrow{font-size:12px;color:var(--muted);margin:0 0 8px}
h1{font-family:var(--font-display);font-weight:575;font-size:clamp(2rem,4.4vw,3rem);letter-spacing:-.025em;line-height:.98;margin:0 0 14px;text-wrap:balance}
h2{font-family:var(--font-display);font-weight:575;font-size:1.15rem;letter-spacing:-.015em;line-height:1.1;margin:0 0 6px;text-wrap:balance}
.sub{margin:0 0 20px;color:var(--muted);font-size:1rem;line-height:1.55;max-width:74ch;text-wrap:pretty}
.sub b{color:var(--fg);font-weight:600}
.app{display:grid;grid-template-columns:292px minmax(0,1fr) 380px;gap:16px;align-items:start}
@media (max-width:1100px){.app{grid-template-columns:292px minmax(0,1fr)}#inspector{grid-column:1/-1;position:static!important}}
@media (max-width:760px){.app{grid-template-columns:1fr}}
.panel{background:var(--raised);border-radius:24px;padding:16px}
.mini{margin:0 0 14px;color:var(--muted);font-size:.86rem;line-height:1.45}
.palette{display:flex;flex-direction:column;gap:14px;padding-bottom:6px;padding-right:14px}
@media (max-width:760px){.palette{flex-direction:row;flex-wrap:wrap}}
.pslot{position:relative;width:260px}
.pslot.used::after{content:"In the map";position:absolute;inset:0;border:1.5px dashed var(--dash);border-radius:16px;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:.88rem;background:var(--raised)}
.pslot.used .blk{visibility:hidden}

/* blocks: one Terra family per block, text in that family's 500 */
.blk{--fill:var(--tangerine-300);--ink:var(--tangerine-500);--blob:46px 72px 52px 66px/60px 48px 62px 52px;position:relative;width:100%;padding:17px 26px 18px;border-radius:var(--blob);color:var(--ink);background:var(--fill);box-shadow:inset 0 2px 0 rgba(255,255,255,.5);cursor:grab;user-select:none;-webkit-user-select:none;touch-action:none}
.blk.find{--fill:var(--tangerine-300);--ink:var(--tangerine-500)}
.blk.enrich{--fill:var(--lemon-300);--ink:var(--lemon-500)}
.blk.claygent{--fill:var(--dragon-300);--ink:var(--dragon-500)}
.blk.sync{--fill:var(--lime-300);--ink:var(--lime-500)}
.blk.find{--blob:46px 72px 52px 66px/60px 48px 62px 52px}.blk.enrich{--blob:72px 50px 70px 48px/52px 66px 54px 68px}.blk.claygent{--blob:54px 66px 48px 74px/66px 54px 70px 50px}.blk.sync{--blob:66px 48px 72px 54px/50px 70px 52px 66px}
.blk.sel.find{--fill:var(--tangerine-200)}.blk.sel.enrich{--fill:var(--lemon-200)}.blk.sel.claygent{--fill:var(--dragon-200)}.blk.sel.sync{--fill:var(--lime-200)}
.blk .t{font-family:var(--font-display);font-weight:575;font-size:.98rem;line-height:1.2;letter-spacing:-.01em}
.blk .say{margin:5px 0 0;font-size:.8rem;line-height:1.4}
.float{position:fixed;z-index:1000;pointer-events:none;width:280px;filter:drop-shadow(0 12px 20px rgba(0,0,0,.14))}

/* the map */
.mapwrap{user-select:none;-webkit-user-select:none;display:flex;flex-direction:column;align-items:center;padding:6px 0 4px}
.mslot{width:300px;min-height:132px;position:relative;display:flex;align-items:center;justify-content:center}
.mslot.empty{color:var(--muted);flex-direction:column;gap:2px;text-align:center}
.mslot .blob{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
.mslot .blob path{fill:none;stroke:var(--dash);stroke-width:3.5;stroke-linecap:round;stroke-dasharray:.1 9;vector-effect:non-scaling-stroke;transition:fill .12s,stroke .12s}
.mslot.over-ok .blob path{stroke:var(--lime-400);fill:var(--ok-bg)}
.mslot.over-bad .blob path{stroke:var(--pom-300);fill:var(--bad-bg)}
.mslot .q,.mslot .meta{position:relative}
.mslot .q{font-family:var(--font-display);font-weight:575;font-size:2rem;line-height:1}
.mslot .meta{font-size:10px}
.mslot.shake{animation:shake .32s}
@keyframes shake{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
@media (prefers-reduced-motion:reduce){.mslot.shake{animation:none}.mslot{transition:none}}
.arrow{color:var(--dash);line-height:0;margin:3px 0}
.arrow.live{color:var(--fg)}
.node{width:300px;display:flex;gap:12px;align-items:center;background:var(--raised);border-radius:16px;padding:12px 14px;cursor:pointer;border:0;font:inherit;color:inherit;text-align:left}
.node:focus-visible,.pill:focus-visible,.linkbtn:focus-visible,.cta-text:focus-visible{outline:3px solid var(--fg);outline-offset:3px}
.node .ic{width:56px;height:56px;display:flex;align-items:center;justify-content:center;flex:none}
.node .ic img{width:52px;height:52px;object-fit:contain;filter:grayscale(1);opacity:.4;transition:filter .25s,opacity .25s}
.node.unlocked .ic img{filter:none;opacity:1}
@media (prefers-reduced-motion:reduce){.node .ic img{transition:none}}
.node .lbl{font-family:var(--font-display);font-weight:575;font-size:1rem;line-height:1.15;letter-spacing:-.01em}
.node .meta{margin-top:5px;font-size:10px;color:var(--muted)}
.node.sel{background:var(--sel-bg)}
.node.sel .ic{color:var(--sel-ic)}
.bar{display:flex;gap:16px;flex-wrap:wrap;align-items:center;margin-top:12px}
#status{flex:1;min-width:220px;font-size:.9rem;line-height:1.4;padding:10px 16px;border-radius:16px;background:var(--raised);color:var(--muted)}
#status.bad{background:var(--bad-bg);color:var(--on-bad)}
#status.ok{background:var(--ok-bg);color:var(--ok-ink)}
.cta-text{font-family:var(--font-display);font-weight:500;font-size:1.05rem;letter-spacing:-.01em;color:var(--fg);background:none;border:0;padding:6px 0 10px;cursor:pointer;position:relative;min-height:44px}
.cta-text::after{content:"";position:absolute;left:0;right:0;bottom:4px;height:3px;border-radius:999px;background:var(--tangerine-300)}

/* inspector */
#inspector{position:sticky;top:12px;min-height:260px}
.tag{display:inline-block;font-size:10px;padding:5px 9px 4px;border-radius:8px;margin-bottom:10px;background:var(--lemon-200);color:var(--lemon-500)}
.tag.bad{background:var(--pom-200);color:var(--pom-500)}
.say2{margin:0 0 12px;font-size:.92rem;line-height:1.5;text-wrap:pretty}
.tblbox{border:1px solid var(--border);border-radius:14px;overflow:hidden;background:var(--bg);margin-bottom:8px}
.tblbox .scroll{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:.82rem}
th,td{text-align:left;padding:9px 12px;border-top:1px solid var(--border);white-space:nowrap}
thead th{border-top:0;background:var(--raised);font-size:10px;color:var(--muted)}
thead th.new{background:var(--new-head);color:var(--ok-ink)}
td.new{background:var(--new-cell)}
.nw{margin-left:6px;font-size:9px}
.skel{display:block;height:9px;width:70%;border-radius:999px;background:var(--skel)}
.chip{background:var(--chip-bg);color:var(--oat-500);border-radius:8px;padding:4px 7px 3px;font-size:10px;line-height:1.25;display:inline-block}
.chip.yes{background:var(--lime-200);color:var(--lime-500)} .chip.no{background:var(--raised);color:var(--muted)}
.chip.plain{background:var(--bg);border:1px solid var(--border);color:var(--fg)}
.caption{font-size:.82rem;color:var(--muted);line-height:1.55;margin:6px 0 0}
.linkbtn{font:inherit;font-weight:600;font-size:.82rem;border:0;background:none;color:var(--fg);text-decoration:underline;text-underline-offset:3px;cursor:pointer;padding:2px 0}
.sect{margin-top:14px}
.callout{margin-top:14px;padding:12px 14px;border-radius:16px;background:var(--ok-bg);color:var(--ok-ink);font-size:.9rem;line-height:1.5}
.needhave{display:grid;gap:8px;margin:10px 0}
.needhave .r{display:flex;gap:10px;align-items:flex-start}
.needhave .l{min-width:92px;padding-top:4px;font-size:10px;color:var(--muted)}

</style>
</head>
<body>
<p class="eyebrow">REVOPS EXERCISE</p>
<h1>Build Crumb &amp; Co.’s café finder</h1>
<p class="sub">You’re on the RevOps team at <b>Crumb &amp; Co.</b>, a small bakery that wants its cookies in cafés across the country. Sales wants to know <b>which cafés already serve Cookie Cartel</b>, because those cafés already buy cookies and might switch. All you have is <b>independent cafés in Chicago, London, Austin, Portland and Berlin</b>. Build a system that finds the cafés and turns them into the right next step for each one.</p>

<div class="app">
  <aside class="panel">
    <h2>Blocks</h2>
    <p class="mini">Click a block to peek at its data. Drag it into a dotted slot on the map.</p>
    <div class="palette" id="palette"></div>
  </aside>
  <section>
    <div class="panel">
      <h2>Your system</h2>
      <p class="mini">Each dotted slot is waiting for a block. The cards between the slots are the data that moves from one block to the next. Click a card to see its columns.</p>
      <div class="mapwrap" id="map"></div>
    </div>
    <div class="bar">
      <div id="status" role="status" aria-live="polite">Start at the top. Which block begins with nothing and ends with a list of cafés?</div>
      <button class="cta-text" id="reset">Start over</button>
    </div>
  </section>
  <aside class="panel" id="inspector" aria-live="polite"></aside>
</div>

<script>
(function(){
"use strict";
var ROWS=[
  {cafe:"Bean & Bloom",city:"Chicago",site:"beanandbloom.example",loc:"Wicker Park",cc:"Yes"},
  {cafe:"The Daily Grind",city:"London",site:"dailygrind.example",loc:"Shoreditch",cc:"No"},
  {cafe:"Hill Country Roast",city:"Austin",site:"hillcountryroast.example",loc:"South Congress",cc:"Yes"},
  {cafe:"Rose City Beans",city:"Portland",site:"rosecitybeans.example",loc:"Alberta Arts",cc:"No"},
  {cafe:"Kiez Kaffee",city:"Berlin",site:"kiezkaffee.example",loc:"Kreuzberg",cc:"Yes"}
];
var COLS={cafe:"Café",city:"City",site:"Website",loc:"Location",cc:"Serves Cookie Cartel?",next:"Next step"};
function val(r,c){
  if(c==="next")return r.cc==="Yes"?"Sales calls with a switch pitch":"Lower priority";
  return r[c];
}
/* data cards between the slots */
var NODES=[
  {label:"List of cafés",icon:"doc",cols:["cafe","city"],newCols:["cafe","city"]},
  {label:"Café website, location",icon:"pin",cols:["cafe","city","site","loc"],newCols:["site","loc"]},
  {label:"Cookie Cartel served?",icon:"cookie",cols:["cafe","city","site","loc","cc"],newCols:["cc"]},
  {label:"Audience",icon:"people",cols:["cafe","city","site","loc","cc","next"],newCols:["next"]}
];
/* blocks: in = index of the data card it reads (null = starts from scratch), out = card it produces */
var BLOCKS={
  find:{cls:"find",title:"Find Companies (Cafés)",in:null,out:0,say:"Searches for independent cafés in Chicago, London, Austin, Portland and Berlin."},
  enrich:{cls:"enrich",title:"Enrich Cafés",in:0,out:1,say:"Looks up each café’s website and where it is."},
  claygent:{cls:"claygent",title:"Claygent: check if website has menu or mentions of Cookie Cartel",in:1,out:2,say:"Reads each café’s website for a menu or any mention of Cookie Cartel, and answers Yes or No."},
  sync:{cls:"sync",title:"Sync List of Cafés to Audience",in:2,out:3,say:"Saves the finished list as an Audience and gives each café its next step."}
};
var ORDER=["find","enrich","claygent","sync"];
var PAL=["claygent","find","sync","enrich"];
/* Terra claymation icons (existing assets, resized) */
var ICON_SRC={"doc": "data:image/png;base64,", "pin": "data:image/png;base64,", "cookie": "data:image/png;base64,", "people": "data:image/png;base64,"};
var BLOBS=["M40 22C90 6 150 18 200 10C250 4 282 28 276 62C272 92 292 108 250 118C200 130 140 114 90 120C40 126 12 100 22 66C28 44 10 34 40 22Z", "M30 40C50 8 120 12 170 20C230 28 290 16 284 58C280 96 250 124 190 118C130 112 90 128 50 112C14 98 10 66 30 40Z", "M52 16C100 4 160 24 214 12C268 2 294 40 280 74C268 106 226 124 176 114C126 106 94 128 54 112C12 94 18 36 52 16Z", "M26 54C28 20 82 8 132 16C180 24 230 6 266 30C298 52 280 92 252 108C216 128 160 110 116 118C66 126 22 100 26 54Z"];
function $(id){return document.getElementById(id);}
function mk(t,c,x){var e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e;}
function esc(s){return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");}
var mapEl=$("map"),paletteEl=$("palette"),statusEl=$("status"),insp=$("inspector");
var state={slots:[null,null,null,null],sel:null,all:false},drag=null,view=null,pslots={};
function setStatus(m,k){statusEl.textContent=m;statusEl.className=k||"";}

/* ---------- fit logic ---------- */
function fitCheck(key,i){
  var b=BLOCKS[key],slotIn=i===0?null:i-1;
  if(b.in===slotIn&&b.out===i)return {ok:true,key:key,i:i};
  var msg;
  if(b.in===null)msg="“"+b.title+"” starts from scratch, but this slot receives “"+NODES[slotIn].label+"”.";
  else if(slotIn===null)msg="“"+b.title+"” needs “"+NODES[b.in].label+"”, but this is the first slot and nothing flows into it.";
  else msg="“"+b.title+"” needs “"+NODES[b.in].label+"”, but this slot receives “"+NODES[slotIn].label+"”.";
  return {ok:false,key:key,i:i,msg:msg};
}

/* ---------- inspector ---------- */
function tableHtml(cols,newKeys,all,ghost){
  var shown=all?cols:cols.filter(function(c){return newKeys.indexOf(c)>-1||c==="cafe";});
  var hidden=cols.filter(function(c){return shown.indexOf(c)<0;});
  var h='<div class="tblbox"><div class="scroll"><table><thead><tr>'+shown.map(function(c){
    var nw=newKeys.indexOf(c)>-1;
    return '<th class="'+(nw?"new":"")+'">'+esc(COLS[c].toUpperCase())+(nw?'<span class="nw">NEW</span>':"")+'</th>';
  }).join("")+'</tr></thead><tbody>'+ROWS.map(function(r){
    return '<tr>'+shown.map(function(c){
      var nw=newKeys.indexOf(c)>-1,inner;
      if(ghost)inner='<span class="skel"></span>';
      else{var v=val(r,c);inner=c==="cc"?'<span class="chip '+(v==="Yes"?"yes":"no")+'">'+v.toUpperCase()+'</span>':esc(v);}
      return '<td class="'+(nw?"new":"")+'">'+inner+'</td>';
    }).join("")+'</tr>';
  }).join("")+'</tbody></table></div></div>';
  return {html:h,hidden:hidden};
}
function chip(t){return '<span class="chip plain">'+esc(t.toUpperCase())+'</span>';}
function nodeView(i,banner,force){
  var n=NODES[i],b=BLOCKS[ORDER[i]],unlocked=force||!!state.slots[i];
  var h=(banner||"")+'<p class="eyebrow">DATA AFTER STEP '+(i+1)+' OF 4</p><h2>'+esc(n.label)+'</h2>';
  if(unlocked){
    h+='<p class="say2">'+esc(b.say)+'</p>';
    var t=tableHtml(n.cols,n.newCols,state.all,false);
    h+=t.html;
    h+='<p class="caption">5 rows. '+(t.hidden.length?'Still in the table: '+t.hidden.map(function(c){return COLS[c];}).join(", ")+'. ':'')+
      (n.cols.length>n.newCols.length||state.all?'<button class="linkbtn" id="toggleCols">'+(state.all?"Show only what’s new":"Show all columns")+'</button>':'')+'</p>';
    if(i===3&&!force&&state.slots.every(Boolean)){
      var yes=ROWS.filter(function(r){return r.cc==="Yes";}).map(function(r){return r.cafe;});
      h+='<div class="callout"><b>Your system is complete.</b> It finds the cafés, adds their websites, checks each one for Cookie Cartel, and saves the list. Sales calls these first: '+esc(yes.join(", "))+'.</div>';
    }
  }else{
    h+='<p class="say2">This is the data the block above hands over. Place that block and the rows fill in.</p>';
    h+=tableHtml(n.cols,n.newCols,true,true).html;
    h+='<p class="caption">Locked for now. The column names hint at what the block above has to do.</p>';
  }
  return h;
}
function blockView(key,banner){
  var b=BLOCKS[key],out=NODES[b.out];
  var h=(banner||"")+'<p class="eyebrow">BLOCK PREVIEW</p><h2>'+esc(b.title)+'</h2><p class="say2">'+esc(b.say)+'</p>';
  h+='<div class="sect"><p class="eyebrow">WHAT IT NEEDS</p>';
  if(b.in===null)h+='<p class="caption">Nothing. This is where the system starts.</p>';
  else{var nn=NODES[b.in];h+='<p class="caption" style="margin:0 0 6px"><b>'+esc(nn.label)+'</b></p>'+tableHtml(nn.cols,[],true,false).html;}
  h+='</div><div class="sect"><p class="eyebrow">WHAT IT GIVES BACK</p><p class="caption" style="margin:0 0 6px"><b>'+esc(out.label)+'</b></p>';
  var gc=["cafe"].concat(out.newCols.filter(function(c){return c!=="cafe";}));
  h+=tableHtml(gc,out.newCols,true,false).html+'<p class="caption">Sample rows.</p></div>';
  return h;
}
function badView(chk){
  var b=BLOCKS[chk.key],slotIn=chk.i===0?null:chk.i-1;
  var h='<span class="tag bad">DOESN’T FIT HERE</span><h2>'+esc(b.title)+'</h2><p class="say2">'+esc(chk.msg)+'</p>';
  h+='<div class="needhave"><div class="r"><span class="lab l">IT NEEDS</span>'+chip(b.in===null?"nothing, it starts the system":NODES[b.in].label)+'</div>'+
     '<div class="r"><span class="lab l">THIS SLOT GETS</span>'+chip(slotIn===null?"nothing, it’s the first slot":NODES[slotIn].label)+'</div></div>';
  h+='<p class="caption">Look at the card above the slot. That’s the data the block has to start from.</p>';
  return h;
}
function paint(){
  var h;
  if(view&&view.type==="bad")h=badView(view.chk);
  else if(view&&view.type==="hover")h=view.html;
  else if(state.sel&&state.sel.t==="node")h=nodeView(state.sel.i);
  else if(state.sel&&state.sel.t==="block")h=blockView(state.sel.key);
  else h='<p class="eyebrow">DATA PEEK</p><h2>See the data between the blocks</h2><p class="say2">Click a card on the map to see its columns. Click a block in the list to see what it needs and what it gives back. As you fill the slots, the rows appear here one step at a time.</p>';
  insp.innerHTML=h;
}
insp.addEventListener("click",function(e){if(e.target.id==="toggleCols"){state.all=!state.all;paint();}});

/* ---------- rendering ---------- */
function blockEl(key){
  var b=BLOCKS[key],el=mk("div","blk "+b.cls);el.dataset.key=key;
  el.appendChild(mk("div","t",b.title));
  el.appendChild(mk("p","say",b.say));
  return el;
}
function arrowEl(live){
  var d=mk("div","arrow"+(live?" live":""));
  d.innerHTML='<svg width="16" height="30" viewBox="0 0 16 30" aria-hidden="true"><path d="M8 1v25M2 20l6 7 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  return d;
}
function render(){
  mapEl.innerHTML="";
  for(var i=0;i<4;i++){
    var key=state.slots[i],slot=mk("div","mslot"+(key?"":" empty"));slot.dataset.i=i;
    if(key){var be=blockEl(key);if(state.sel&&state.sel.t==="block"&&state.sel.key===key)be.classList.add("sel");slot.appendChild(be);}
    else{slot.innerHTML='<svg class="blob" viewBox="0 0 300 130" preserveAspectRatio="none" aria-hidden="true"><path d="'+BLOBS[i]+'"/></svg>';slot.appendChild(mk("div","q","?"));slot.appendChild(mk("div","meta","DROP A BLOCK HERE"));}
    mapEl.appendChild(slot);
    mapEl.appendChild(arrowEl(!!key));
    var n=NODES[i],unlocked=!!key;
    var nd=mk("button","node"+(unlocked?" unlocked":"")+(state.sel&&state.sel.t==="node"&&state.sel.i===i?" sel":""));nd.dataset.i=i;nd.type="button";
    var ic=mk("span","ic");ic.innerHTML='<img alt="" src="'+ICON_SRC[n.icon]+'">';nd.appendChild(ic);
    var tx=mk("span");tx.appendChild(mk("div","lbl",n.label));
    tx.appendChild(mk("div","meta",unlocked?"5 ROWS"+(i>0?" · NEW: "+n.newCols.map(function(c){return COLS[c].toUpperCase();}).join(", "):""):"LOCKED"));
    nd.appendChild(tx);mapEl.appendChild(nd);
    if(i<3)mapEl.appendChild(arrowEl(unlocked));
  }
  PAL.forEach(function(k){pslots[k].classList.toggle("used",state.slots.indexOf(k)>-1);});
}
PAL.forEach(function(key){
  var s=mk("div","pslot"),el=blockEl(key);
  s.appendChild(el);paletteEl.appendChild(s);pslots[key]=s;
  el.addEventListener("pointerdown",function(e){
    if(e.button>0)return;e.preventDefault();
    var r=el.getBoundingClientRect();
    arm(e,e.clientX-r.left,e.clientY-r.top,function(){return {key:key,from:null};},function(){
      view=null;state.sel={t:"block",key:key};render();paint();setStatus("Previewing “"+BLOCKS[key].title+"”. Drag it into a slot to use it.");
    });
  });
});
mapEl.addEventListener("click",function(e){
  var nd=e.target.closest(".node");
  if(nd){view=null;state.sel={t:"node",i:+nd.dataset.i};render();paint();}
});
mapEl.addEventListener("pointerdown",function(e){
  if(e.button>0)return;
  var b=e.target.closest(".blk");if(!b)return;
  e.preventDefault();
  var key=b.dataset.key,si=+b.closest(".mslot").dataset.i,r=b.getBoundingClientRect();
  arm(e,e.clientX-r.left,e.clientY-r.top,function(){state.slots[si]=null;render();return {key:key,from:si};},function(){
    view=null;state.sel={t:"node",i:si};render();paint();
  });
});

/* ---------- dragging ---------- */
function arm(e,offX,offY,make,onClick){
  var sx=e.clientX,sy=e.clientY;
  function cleanup(){window.removeEventListener("pointermove",mv);window.removeEventListener("pointerup",up);window.removeEventListener("pointercancel",cancel);}
  function mv(ev){
    if(Math.abs(ev.clientX-sx)+Math.abs(ev.clientY-sy)<5)return;
    cleanup();var o=make();if(o)startDrag(o,ev,offX,offY);
  }
  function up(){cleanup();if(onClick)onClick();}
  function cancel(){cleanup();}
  window.addEventListener("pointermove",mv);window.addEventListener("pointerup",up);window.addEventListener("pointercancel",cancel);
}
function startDrag(o,ev,offX,offY){
  var f=mk("div","float");f.appendChild(blockEl(o.key));document.body.appendChild(f);
  f.style.left=(ev.clientX-offX)+"px";f.style.top=(ev.clientY-offY)+"px";
  drag={key:o.key,from:o.from,f:f,offX:offX,offY:offY,sig:""};
  window.addEventListener("pointermove",onMove);window.addEventListener("pointerup",onUp);window.addEventListener("pointercancel",onUp);
  update(ev);
}
function slotAt(x,y){
  var els=mapEl.querySelectorAll(".mslot");
  for(var i=0;i<els.length;i++){
    var r=els[i].getBoundingClientRect();
    if(x>=r.left-24&&x<=r.right+24&&y>=r.top-14&&y<=r.bottom+14)return i;
  }
  return -1;
}
function clearOver(){mapEl.querySelectorAll(".mslot").forEach(function(el){el.classList.remove("over-ok","over-bad");});}
function update(ev){
  var i=slotAt(ev.clientX,ev.clientY);
  clearOver();
  if(i<0){
    drag.over=-1;
    if(drag.sig!=="none"){drag.sig="none";view={type:"hover",html:blockView(drag.key)};paint();setStatus("Drop it into a dotted slot.");}
    return;
  }
  var chk=fitCheck(drag.key,i);
  mapEl.querySelectorAll(".mslot")[i].classList.add(chk.ok?"over-ok":"over-bad");
  drag.over=i;
  var sig=i+"|"+chk.ok;if(sig===drag.sig)return;drag.sig=sig;
  if(chk.ok){view={type:"hover",html:nodeView(i,'<span class="tag">PREVIEW IF YOU PLACE IT HERE</span>',true)};setStatus("Release to place it here.","ok");}
  else{view={type:"bad",chk:chk};setStatus(chk.msg,"bad");}
  paint();
}
function onMove(ev){
  drag.f.style.left=(ev.clientX-drag.offX)+"px";drag.f.style.top=(ev.clientY-drag.offY)+"px";
  update(ev);
}
function onUp(ev){
  window.removeEventListener("pointermove",onMove);window.removeEventListener("pointerup",onUp);window.removeEventListener("pointercancel",onUp);
  var d=drag;drag=null;d.f.remove();clearOver();
  var i=slotAt(ev.clientX,ev.clientY);
  if(i>=0){
    var chk=fitCheck(d.key,i);
    if(chk.ok){
      state.slots[i]=d.key;state.sel={t:"node",i:i};view=null;render();paint();
      if(state.slots.every(Boolean))setStatus("That’s the whole system. Every block turns the data above it into the data below it.","ok");
      else setStatus("It fits. Check the data peek to see what the block produced.","ok");
      return;
    }
    if(d.from!==null)state.slots[d.from]=d.key;
    view={type:"bad",chk:chk};state.sel=null;render();paint();
    var el=mapEl.querySelectorAll(".mslot")[i];el.classList.add("shake");
    setStatus(chk.msg,"bad");return;
  }
  view=null;
  if(state.sel&&state.sel.t==="node"&&!state.slots[state.sel.i])state.sel=null;
  render();paint();setStatus("Block put back.");
}
$("reset").addEventListener("click",function(){
  state.slots=[null,null,null,null];state.sel=null;view=null;render();paint();
  setStatus("Start at the top. Which block begins with nothing and ends with a list of cafés?");
});
render();paint();
})();
</script>
</body>
